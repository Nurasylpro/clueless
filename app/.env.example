# Copy this file to .env and fill in ONE of the two options. .env is never committed.

# ── Option A: Claude in Amazon Bedrock ─────────────────────────────────────────
AWS_REGION=us-east-1
# Sign in ONE way:
#   1) A Bedrock API key (AWS console → Amazon Bedrock → API keys), the simplest:
AWS_BEARER_TOKEN_BEDROCK=
#   2) An AWS CLI profile (after `aws configure sso` or `aws configure`):
# AWS_PROFILE=
#   3) Access keys:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# ── Option B: the Claude API ───────────────────────────────────────────────────
# ANTHROPIC_API_KEY=

# ── Optional ───────────────────────────────────────────────────────────────────
# Model. Bedrock default: anthropic.claude-opus-5-5. If your AWS account doesn't have
# Opus 5.5 access yet, use anthropic.claude-opus-4-8 (open to every Bedrock account).
# CLUELESS_MODEL=anthropic.claude-opus-5-5
# Force a provider if both options are filled in: bedrock or anthropic
# CLUELESS_PROVIDER=bedrock
# How hard Claude thinks when it traces your code: low | medium | high | xhigh | max.
# Default: medium for short code, high for longer. max is slowest (about 90 s on a small sort).
# CLUELESS_TRACE_EFFORT=high
# Voice feature
# DEEPGRAM_API_KEY=
